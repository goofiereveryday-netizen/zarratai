{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/.github/tauri-v2-schema.json",
  "productName": "ZarratAI",
  "version": "0.1.0",
  "identifier": "com.zarratai.app",
  "build": {
    "frontendDist": "../out",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "ZarratAI",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
